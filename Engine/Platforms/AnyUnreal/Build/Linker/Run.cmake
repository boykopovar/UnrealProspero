cmake_minimum_required(VERSION 3.22)
include("${ANYUNREAL_MANIFEST}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${CMAKE_CURRENT_LIST_DIR}" -B "${ANYUNREAL_BUILD_DIRECTORY}" -G Ninja "-DANYUNREAL_MANIFEST=${ANYUNREAL_MANIFEST}" "-DCMAKE_BUILD_TYPE=${ANYUNREAL_CONFIGURATION}" "-DCMAKE_TOOLCHAIN_FILE=${ANYUNREAL_TOOLCHAIN}" "-DAnyDevKit_DIR=${ANYUNREAL_SDK_CONFIG}" "-DADK_DEPENDENCY_ROOT=${ANYUNREAL_DEPENDENCIES}" "-DADK_SYSROOT=${ANYUNREAL_SYSROOT}" "-DADK_COMPILER=${ANYUNREAL_COMPILER}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${ANYUNREAL_BUILD_DIRECTORY}" --target AnyUnrealApplication --parallel 1 COMMAND_ERROR_IS_FATAL ANY)
if(NOT EXISTS "${ANYUNREAL_OUTPUT}")
    message(FATAL_ERROR "Linker did not produce ${ANYUNREAL_OUTPUT}")
endif()
