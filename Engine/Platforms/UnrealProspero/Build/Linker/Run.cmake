cmake_minimum_required(VERSION 3.22)
include("${UNREALPROSPERO_MANIFEST}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${CMAKE_CURRENT_LIST_DIR}" -B "${UNREALPROSPERO_BUILD_DIRECTORY}" -G Ninja "-DUNREALPROSPERO_MANIFEST=${UNREALPROSPERO_MANIFEST}" "-DCMAKE_BUILD_TYPE=${UNREALPROSPERO_CONFIGURATION}" "-DCMAKE_TOOLCHAIN_FILE=${UNREALPROSPERO_TOOLCHAIN}" "-DAnyDevKit_DIR=${UNREALPROSPERO_SDK_CONFIG}" "-DADK_DEPENDENCY_ROOT=${UNREALPROSPERO_DEPENDENCIES}" "-DADK_SYSROOT=${UNREALPROSPERO_SYSROOT}" "-DADK_COMPILER=${UNREALPROSPERO_COMPILER}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${UNREALPROSPERO_BUILD_DIRECTORY}" --target UnrealProsperoApplication --parallel 1 COMMAND_ERROR_IS_FATAL ANY)
if(NOT EXISTS "${UNREALPROSPERO_OUTPUT}")
    message(FATAL_ERROR "Linker did not produce ${UNREALPROSPERO_OUTPUT}")
endif()
