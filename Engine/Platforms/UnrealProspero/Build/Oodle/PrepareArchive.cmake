cmake_minimum_required(VERSION 3.24)

function(read_symbols output file)
    execute_process(COMMAND "${LLVM_NM}" --just-symbol-name -g ${ARGN} "${file}" OUTPUT_VARIABLE text COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE "\n" ";" symbols "${text}")
    list(FILTER symbols EXCLUDE REGEX "^$|:$")
    list(REMOVE_DUPLICATES symbols)
    set(${output} "${symbols}" PARENT_SCOPE)
endfunction()

read_symbols(undefined "${OODLE_ARCHIVE}" --undefined-only)
read_symbols(defined "${OODLE_ARCHIVE}" --defined-only)
read_symbols(imports "${LIBC_IMPORT_LIBRARY}" --defined-only --dynamic)
if(NOT "OodleLZ_Compress" IN_LIST defined OR NOT "OodleLZ_Decompress" IN_LIST defined)
    message(FATAL_ERROR "The input does not export the Oodle compression API")
endif()
set(arguments)
foreach(symbol IN LISTS undefined)
    if(symbol IN_LIST defined OR symbol STREQUAL "__dso_handle")
        continue()
    endif()
    set(replacement "${symbol}")
    if(symbol STREQUAL "__ctype_b_loc")
        set(replacement UnrealProsperoOodleCtype)
    elseif(symbol STREQUAL "__ctype_tolower_loc")
        set(replacement UnrealProsperoOodleLowercase)
    elseif(symbol STREQUAL "__ctype_toupper_loc")
        set(replacement UnrealProsperoOodleUppercase)
    else()
        if(symbol STREQUAL "stdout")
            set(replacement __stdoutp)
        elseif(symbol STREQUAL "stderr")
            set(replacement __stderrp)
        elseif(symbol STREQUAL "memcpy@GLIBC_2.2.5")
            set(replacement memcpy)
        endif()
        string(APPEND replacement "_nid_postfix")
        if(NOT replacement IN_LIST imports)
            message(FATAL_ERROR "Unsupported Oodle runtime dependency: ${symbol}")
        endif()
    endif()
    list(APPEND arguments "--redefine-sym=${symbol}=${replacement}")
endforeach()
execute_process(COMMAND "${LLVM_OBJCOPY}" ${arguments} "${OODLE_ARCHIVE}" "${OUTPUT}.tmp" COMMAND_ERROR_IS_FATAL ANY)
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
